<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a class="logo" href="/" aria-label="<%= brand.name %> home">
      <span class="logo-mark" aria-hidden="true">G</span><%= brand.name %>
    </a>
    <nav class="nav-links" id="navLinks" aria-label="Main navigation">
      <a class="nl <%= active === 'home' ? 'on' : '' %>" href="/">Home</a>
      <a class="nl <%= active === 'services' ? 'on' : '' %>" href="/services">Services</a>
      <a class="nl <%= active === 'work' ? 'on' : '' %>" href="/work">Work</a>
      <a class="nl <%= active === 'pricing' ? 'on' : '' %>" href="/pricing">Pricing</a>
      <a class="nl <%= active === 'about' ? 'on' : '' %>" href="/about">About</a>
      <a class="nl <%= active === 'contact' ? 'on' : '' %>" href="/contact">Contact</a>
    </nav>
    <div class="nav-cta">
      <% if (user) { %>
        <a class="btn btn-ghost btn-sm" href="<%= user.role === 'admin' ? '/admin' : '/dashboard' %>">My account</a>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login">Log in</a>
        <a class="btn btn-primary btn-sm" href="/contact">Free consultation <span class="arr">→</span></a>
      <% } %>
      <button class="burger" id="burger" aria-label="Open menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
