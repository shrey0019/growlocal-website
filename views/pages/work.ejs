<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main>
  <section class="hero" style="min-height:60svh; padding-bottom:50px;">
    <div class="aurora" aria-hidden="true">
      <div class="blob b2" data-parallax="-0.08"></div>
      <div class="blob b3" data-parallax="0.18"></div>
    </div>
    <div class="wrap" style="position:relative; z-index:2">
      <span class="eyebrow reveal">Sample work</span>
      <h1 class="reveal"><span class="kinetic">The kind of work</span> <span class="kinetic"><span class="grad-text">we ship.</span></span></h1>
      <p class="lead reveal" style="--d:0.15s">These are sample concepts we made to show our style and range. Real client work follows the same bar: clean, fast, and built to bring enquiries.</p>
    </div>
  </section>

  <section style="padding-top:20px;">
    <div class="wrap">
      <div class="work-grid">
        <article class="work-card reveal">
          <div class="work-visual wv1" role="img" aria-label="Sample concept: reel editing style frame for a gym">
            <div class="wv-inner"><div class="mock">POWERHOUSE GYM</div><div class="sub">Reel concept · bold captions · 0:18</div></div>
          </div>
          <div class="work-body">
            <h3>Gym promo reel series</h3>
            <p>Twelve reels for a Bhopal gym: transformation clips, trainer intros and offer announcements, all cut with punchy captions and hooks in the first two seconds.</p>
            <div class="tag-row"><span class="tag">Reel editing</span><span class="tag">Captions</span><span class="tag">Fitness</span></div>
          </div>
        </article>
        <article class="work-card reveal" style="--d:0.1s">
          <div class="work-visual wv2" role="img" aria-label="Sample concept: WhatsApp catalog mockup for a salon">
            <div class="wv-inner"><div class="mock">GLOW STUDIO</div><div class="sub">WhatsApp catalog · auto-replies · broadcast</div></div>
          </div>
          <div class="work-body">
            <h3>Salon WhatsApp system</h3>
            <p>Full WhatsApp Business setup for a salon: service catalog with prices, instant booking replies, and a festival broadcast list that filled their Diwali slots in four days.</p>
            <div class="tag-row"><span class="tag">WhatsApp setup</span><span class="tag">Catalog</span><span class="tag">Automation</span></div>
          </div>
        </article>
        <article class="work-card reveal">
          <div class="work-visual wv3" role="img" aria-label="Sample concept: website homepage mockup for a coaching institute">
            <div class="wv-inner"><div class="mock">ASPIRE CLASSES</div><div class="sub">5-page website · admissions open</div></div>
          </div>
          <div class="work-body">
            <h3>Coaching institute website</h3>
            <p>A five page site for a coaching institute: courses, faculty, results wall and a WhatsApp enquiry button on every screen. Loads in under two seconds on mobile data.</p>
            <div class="tag-row"><span class="tag">Website</span><span class="tag">Mobile-first</span><span class="tag">Education</span></div>
          </div>
        </article>
        <article class="work-card reveal" style="--d:0.1s">
          <div class="work-visual wv4" role="img" aria-label="Sample concept: Google Business Profile panel for a clinic">
            <div class="wv-inner"><div class="mock">CITY CARE CLINIC</div><div class="sub">Google profile · 4.8 rating · 2.1k calls</div></div>
          </div>
          <div class="work-body">
            <h3>Clinic Google profile</h3>
            <p>Claimed, verified and optimised Google Business Profile for a clinic: real photos, services listed, review replies handled weekly. Calls from Maps doubled in two months.</p>
            <div class="tag-row"><span class="tag">Google Business</span><span class="tag">Local SEO</span><span class="tag">Healthcare</span></div>
          </div>
        </article>
        <article class="work-card reveal">
          <div class="work-visual wv5" role="img" aria-label="Sample concept: social media grid for a restaurant">
            <div class="wv-inner"><div class="mock">SPICE ROUTE</div><div class="sub">30-day content · reels + carousels</div></div>
          </div>
          <div class="work-body">
            <h3>Restaurant content month</h3>
            <p>A full month of Instagram content for a restaurant: dish reels, behind-the-scenes stories and weekend offer carousels, planned around the local festival calendar.</p>
            <div class="tag-row"><span class="tag">Social media</span><span class="tag">Content plan</span><span class="tag">Food</span></div>
          </div>
        </article>
        <article class="work-card reveal" style="--d:0.1s">
          <div class="work-visual wv6" role="img" aria-label="Sample concept: pitch deck cover for a franchise">
            <div class="wv-inner"><div class="mock">FITZONE FRANCHISE</div><div class="sub">14-slide deck · investment pitch</div></div>
          </div>
          <div class="work-body">
            <h3>Franchise pitch deck</h3>
            <p>A fourteen slide franchise pitch: market story, unit economics, and partner benefits, designed to be presented in twenty minutes and remembered afterwards.</p>
            <div class="tag-row"><span class="tag">Pitch deck</span><span class="tag">Design</span><span class="tag">Fitness</span></div>
          </div>
        </article>
      </div>

      <div class="cta-band reveal" style="margin-top:90px;">
        <div style="position:relative; z-index:2">
          <h2>Your business could be next</h2>
          <p>Tell us what you sell. We will show you exactly what we would make for you before you pay a rupee.</p>
          <a class="btn btn-primary" href="/contact">Start the conversation <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
