<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="admin-shell">
  <%- include('../partials/admin-side') %>
  <div class="admin-main">
    <h1>Dashboard</h1>
    <p class="admin-sub">The whole business at a glance.</p>
    <% if (ok) { %><div class="alert ok" role="status"><%= ok %></div><% } %>
    <% if (err) { %><div class="alert err" role="alert"><%= err %></div><% } %>
    <div class="stat-cards">
      <div class="stat-card"><div class="sk">Customers</div><div class="sv o"><%= stats.users %></div></div>
      <div class="stat-card"><div class="sk">Total orders</div><div class="sv"><%= stats.orders %></div></div>
      <div class="stat-card"><div class="sk">Pending orders</div><div class="sv t"><%= stats.pending %></div></div>
      <div class="stat-card"><div class="sk">New leads</div><div class="sv o"><%= stats.leads %></div></div>
    </div>
    <div class="panel">
      <h2>Latest orders</h2>
      <p class="psub">The 8 most recent requests.</p>
      <% if (recent.length === 0) { %>
      <div class="empty"><p>No orders yet.</p></div>
      <% } else { %>
      <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr><th>#</th><th>Customer</th><th>Service</th><th>Status</th><th>Date</th></tr></thead>
        <tbody>
          <% recent.forEach(function(o) { %>
          <tr><td><b>#<%= o.id %></b></td><td><%= o.user_name %></td><td><%= o.service_name %></td>
          <td><span class="status <%= o.status.replace(' ', '') %>"><%= o.status %></span></td><td style="white-space:nowrap"><%= o.created_at.slice(0,10) %></td></tr>
          <% }); %>
        </tbody>
      </table>
      </div>
      <% } %>
      <div style="margin-top:20px"><a class="btn btn-ghost btn-sm" href="/admin/orders">Manage all orders <span class="arr">→</span></a></div>
    </div>
  </div>
</div>
<script src="/js/main.js" defer></script>
</body>
</html>
